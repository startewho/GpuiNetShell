<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>GpuiNetShell</RootNamespace>
        <AssemblyName>GpuiNetShell</AssemblyName>
        <!-- The runtime only uses P/Invoke, function pointers, and
             UnmanagedCallersOnly; this turns on the trim/AOT analyzers so an
             AOT-incompatible change fails the build instead of the publish. -->
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>GpuiNetShell</PackageId>
        <Description>C# host for the GPUI shell runtime: a managed View/Element API over a versioned C ABI, with the Rust native host shipped by GpuiNetShell.Native.</Description>
        <PackageTags>gpui;gui;ui;native;shell;rust</PackageTags>
        <RepositoryUrl>https://github.com/anomalyco/opencode</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <PropertyGroup>
        <RepositoryRoot>$(MSBuildThisFileDirectory)..\..</RepositoryRoot>
        <!-- Match the native host to the managed configuration: Release uses a
             release cargo build, everything else the debug host. -->
        <NativeProfile Condition="'$(Configuration)' == 'Release'">release</NativeProfile>
        <NativeProfile Condition="'$(NativeProfile)' == ''">debug</NativeProfile>
        <NativeCargoArgs Condition="'$(NativeProfile)' == 'release'">--release</NativeCargoArgs>
        <NativeOutputDir>$(RepositoryRoot)\target\$(NativeProfile)</NativeOutputDir>
    </PropertyGroup>

    <!-- The native host is part of this build: an ABI or schema change rebuilds
         both sides together. Set SkipNativeBuild=true to use a prebuilt host. -->
    <Target Name="BuildNativeHost" BeforeTargets="BeforeBuild" Condition="'$(SkipNativeBuild)' != 'true'">
        <Exec Command="cargo build -p gpui-net-shell $(NativeCargoArgs)" WorkingDirectory="$(RepositoryRoot)" />
    </Target>

    <ItemGroup>
        <None Include="$(NativeOutputDir)\gpui_net_shell.dll" Condition="Exists('$(NativeOutputDir)\gpui_net_shell.dll')">
            <Link>gpui_net_shell.dll</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </None>
    </ItemGroup>

    <!-- The package ships the source generator as an analyzer. -->
    <ItemGroup>
        <ProjectReference Include="..\GpuiNetShell.SourceGen\GpuiNetShell.SourceGen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
        <None Include="..\GpuiNetShell.SourceGen\bin\$(Configuration)\netstandard2.0\GpuiNetShell.SourceGen.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
        <None Include="$(RepositoryRoot)\README.md" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>

    <!-- The released package depends on the matching native package. Kept behind
         a property so an ordinary local build never restores it; the release
         workflow packs GpuiNetShell.Native first and passes
         -p:PackNativeReference=true with a local package source. -->
    <ItemGroup Condition="'$(PackNativeReference)' == 'true'">
        <PackageReference Include="GpuiNetShell.Native" Version="$(Version)" IncludeAssets="all" PrivateAssets="none" />
    </ItemGroup>
</Project>
